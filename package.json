{
  "name": "cracklab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bilingual, client-side credential-attack simulator: it shows how password attacks work and how modern defenses raise their cost, never a cracker.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.12.0 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "dev:network": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node --experimental-strip-types scripts/static-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "analyze:bundle": "vite build --mode analyze",
    "verify": "npm run verify:lockfile && npm run verify:model && npm run verify:deployment-security && npm run verify:release && npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run verify:performance",
    "verify:performance": "node --test scripts/performance-budget.test.mjs && size-limit && node scripts/performance-budget.mjs",
    "verify:model": "node --test scripts/model-data.test.mjs && node scripts/model-data.mjs",
    "verify:deployment-security": "node --test scripts/deployment-security.test.mjs && node scripts/deployment-security.mjs",
    "verify:release": "node --test scripts/release-metadata.test.mjs",
    "verify:lockfile:bootstrap": "node --test scripts/verify-lockfile.test.mjs && node scripts/verify-lockfile.mjs",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity --validate-package-names --empty-hostname false",
    "verify:lockfile": "npm run verify:lockfile:bootstrap && npm run lint:lockfile",
    "sync:labels": "node scripts/sync-labels.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high",
    "audit:signatures:runtime": "npm audit signatures --omit=dev",
    "audit:signatures:full": "npm audit signatures"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-it": "^4.1.1",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lockfile-lint": "^5.1.0",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.3.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "Initial JavaScript (gzip)",
      "path": "dist/assets/index-*.js",
      "gzip": true,
      "limit": "160 kB"
    }
  ]
}
